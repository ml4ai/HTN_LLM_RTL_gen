(define (problem tri_state)
  (:domain rtl_fsm)
  (:objects
    tri_state - module
    clk rst a f - port
    X Y Z - fsm_state
  )
  (:htn
    :parameters ()
    :subtasks (and (implement_module tri_state))
  )
  (:init
    (first_port tri_state clk)
    (next_port clk rst)
    (next_port rst a)
    (next_port a f)
    (last_port tri_state f)
    (input_port clk)
    (input_port rst)
    (input_port a)
    (output_port f)
    (clock_of tri_state clk)
    (reset_of tri_state rst)
    (reset_polarity rst active_high)
    (data_input_of tri_state a)
    (table_fsm tri_state)
    (moore tri_state)
    (initial_state tri_state X)
    (first_listed tri_state X)
    (listed_after X Y)
    (listed_after Y Z)
    (last_listed tri_state Z)
    (table_next X zero X)
    (table_next X one Y)
    (table_next Y zero Z)
    (table_next Y one Y)
    (table_next Z zero X)
    (table_next Z one Y)
    (asserted_in f Z)
  )
)
