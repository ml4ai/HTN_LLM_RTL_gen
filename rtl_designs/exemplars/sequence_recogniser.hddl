(define (problem run_len)
  (:domain rtl_fsm)
  (:objects
    run_len - module
    clk reset bit_in pair long_run - port
  )
  (:htn
    :parameters ()
    :subtasks (and (implement_module run_len))
  )
  (:init
    (first_port run_len clk)
    (next_port clk reset)
    (next_port reset bit_in)
    (next_port bit_in pair)
    (next_port pair long_run)
    (last_port run_len long_run)
    (input_port clk)
    (input_port reset)
    (input_port bit_in)
    (output_port pair)
    (output_port long_run)
    (clock_of run_len clk)
    (reset_of run_len reset)
    (reset_polarity reset active_high)
    (data_input_of run_len bit_in)
    (sequence_recogniser run_len)
    (moore run_len)
    (recognises run_len pair seq0110)
    (recognises run_len long_run seq0111)
    (keeps_while long_run one)
    (reset_as_previous run_len zero)
  )
)
