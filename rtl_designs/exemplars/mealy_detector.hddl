(define (problem det1101)
  (:domain rtl_fsm)
  (:objects
    det1101 - module
    clk rst din found - port
    s0 s1 s2 s3 - fsm_state
  )
  (:htn
    :parameters ()
    :subtasks (and (implement_module det1101))
  )
  (:init
    (first_port det1101 clk)
    (next_port clk rst)
    (next_port rst din)
    (next_port din found)
    (last_port det1101 found)
    (input_port clk)
    (input_port rst)
    (input_port din)
    (output_port found)
    (clock_of det1101 clk)
    (reset_of det1101 rst)
    (reset_polarity rst active_high)
    (data_input_of det1101 din)
    (detect_output_of det1101 found)
    (sequence_detector det1101)
    (mealy det1101)
    (overlapping det1101)
    (initial_state det1101 s0)
    (last_state det1101 s3)
    (next_prefix s0 s1)
    (next_prefix s1 s2)
    (next_prefix s2 s3)
    (expects s0 one)
    (expects s1 one)
    (expects s2 zero)
    (expects s3 one)
  )
)
