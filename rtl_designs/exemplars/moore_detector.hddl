(define (problem seen_110)
  (:domain rtl_fsm)
  (:objects
    seen_110 - module
    clock reset_n d hit - port
    WAIT GOT1 GOT11 DONE - fsm_state
  )
  (:htn
    :parameters ()
    :subtasks (and (implement_module seen_110))
  )
  (:init
    (first_port seen_110 clock)
    (next_port clock reset_n)
    (next_port reset_n d)
    (next_port d hit)
    (last_port seen_110 hit)
    (input_port clock)
    (input_port reset_n)
    (input_port d)
    (output_port hit)
    (clock_of seen_110 clock)
    (reset_of seen_110 reset_n)
    (reset_async reset_n)
    (reset_polarity reset_n active_low)
    (data_input_of seen_110 d)
    (detect_output_of seen_110 hit)
    (sequence_detector seen_110)
    (moore seen_110)
    (overlapping seen_110)
    (initial_state seen_110 WAIT)
    (last_state seen_110 DONE)
    (accept_state seen_110 DONE)
    (next_prefix WAIT GOT1)
    (next_prefix GOT1 GOT11)
    (next_prefix GOT11 DONE)
    (expects WAIT one)
    (expects GOT1 one)
    (expects GOT11 zero)
  )
)
