; VerilogEval v2 Prob140_fsm_hdlc, restated as facts for
; rtl_designs/rtl_domain.hddl. Hand-written for the P-series pilot
; (LLM_RTL_code_generation.md 8.6.5).
;
; Neither the states nor the transitions are here. The problem compiler
; (problem_compiler.py) expands the three sequences into the states they need,
; and the planner derives where each state goes.
;
;   "Create a Moore-type finite state machine to recognize these three
;    sequences" -> (sequence_recogniser ...) (moore ...)
;   "(1) 0111110: Signal a bit needs to be discarded (disc)"
;        -> (recognises TopModule disc seq0111110)
;   "(2) 01111110: Flag the beginning/end of a frame (flag)"
;        -> (recognises TopModule flag seq01111110)
;   "(3) 01111111...: Error (7 or more 1s) (err)"
;        -> (recognises TopModule err seq01111111), and (keeps_while err one):
;           the "..." and "or more" say it goes on while 1s keep arriving
;   "When the FSM is reset, it should be in a state that behaves as though the
;    previous input were 0" -> (reset_as_previous TopModule zero)
;   "The reset signal is active high synchronous"
;        -> (reset_polarity reset active_high), no (reset_async ...)
;   "The output signals should be asserted for a complete cycle beginning on
;    the clock cycle after the condition occurs" -> Moore: each output is 1 in
;    the state its sequence ends in, which is what the family means
;   "implement a module named TopModule"; the ports, in the order given

(define (problem fsm_hdlc)
  (:domain rtl_fsm)
  (:objects
    TopModule - module
    clk reset in disc flag err - port
    seq0111110 seq01111110 seq01111111 - bitseq
  )
  (:htn
    :parameters ()
    :subtasks (and (implement_module TopModule))
  )
  (:init
    ; interface
    (first_port TopModule clk)
    (next_port clk reset)
    (next_port reset in)
    (next_port in disc)
    (next_port disc flag)
    (next_port flag err)
    (last_port TopModule err)
    (input_port clk)
    (input_port reset)
    (input_port in)
    (output_port disc)
    (output_port flag)
    (output_port err)
    (data_input_of TopModule in)
    (clock_of TopModule clk)
    (reset_of TopModule reset)
    (reset_polarity reset active_high)

    ; behaviour
    (sequence_recogniser TopModule)
    (moore TopModule)
    (recognises TopModule disc seq0111110)
    (recognises TopModule flag seq01111110)
    (recognises TopModule err seq01111111)
    (keeps_while err one)
    (reset_as_previous TopModule zero)
  )
)
