; RTL design domain: decomposes "implement this module" into an ordered list of
; symbolic design and coding steps, each of which is meant to map onto one
; instruction for an LLM writing the Verilog.
;
; Two kinds of primitive action:
;
;   analyze_*   a design decision, worked out by the planner from the spec
;               (which states exist, where each transition goes, when the
;               output fires). They write derived facts and emit no code.
;   write_*     one piece of code to write, using only facts the spec gave or
;               an analyze_* step derived.
;
; Action parameters are named for their role (?state, ?next_if_0, ...): the
; plan formats of LLM_RTL_code_generation.md 8.6.1 print them as named
; arguments, so the names are part of what the executor reads.
;
; Design families covered (hand-written for the P-series pilot, 8.6.5; a
; reproducible procedure for building domains is future work):
;
;   1. Mealy sequence detector: one serial input, overlapping or not, reset
;      async or sync of either polarity. The original family (rtl_designs/fsm).
;   2. Moore sequence detector: the same derivation, plus one accepting state
;      whose output is 1.
;   3. Moore FSM given by a state table or diagram: the planner reads the
;      table into transitions.
;   4. Sequence recogniser (HDLC framing): a Moore FSM that recognises several
;      bit sequences at once, with an output for each.
;   5. Wrap-around counter with an enable.
;   6. Triangle-wave generator: an up/down counter steered by a direction
;      register.
;
; Families 1-4 are written as the conventional FSM: a state register, a
; combinational next-state block, and output logic (combinational from state
; and input for Mealy; decoded from the state alone for Moore).
;
; ---- families 1 and 2: sequence detectors ----
;
; The problem file restates the design description as facts and nothing more.
; In particular it gives the pattern bit by bit, one state per bit:
;
;   (expects s_k b)      the pattern's bit k is b: in state s_k the first k
;                        bits have been matched and b is the next one wanted
;   (next_prefix s_k s_k+1), (initial_state m s_0), (last_state m s_last)
;
; For Moore, s_last is the extra accepting state s_L, (accept_state m s_L),
; with no expected bit. It does NOT give the transition table. The planner
; derives every transition, including where a mismatch falls back to and
; where detection restarts after a match, with the Knuth-Morris-Pratt
; construction written as methods:
;
;   fallback(s_1)   = s_0
;   fallback(s_k)   = next(fallback(s_k-1), pattern[k-1])        for k >= 2
;   next(s_k, b)    = s_k+1                                if b = pattern[k]
;                   = s_0                                  if b /= pattern[k], k = 0
;                   = next(fallback(s_k), b)               if b /= pattern[k], k > 0
;   Mealy:  next(s_L-1, pattern[L-1]) = next(fallback(s_L-1), pattern[L-1])
;           (overlapping; the output fires on this transition)
;   Moore:  next(s_L, b) = next(fallback(s_L), b)  (overlapping), next(s_0, b) (not)
;
; Every recursive call is on a strictly earlier state, so the decomposition
; terminates. Derived facts are memoised through the *_known predicates, and
; an already-known fact is reused by an empty method rather than derived twice.
;
; ---- families 3 and 4: listed states ----
;
; The states are listed in the order to declare them, (first_listed m s),
; (listed_after s t), (last_listed m s). Each output is 1 in exactly one
; state, (asserted_in o s).
;
; A table FSM gives every transition, (table_next s b t), and the planner
; reads them.
;
; A sequence recogniser gives only the sequences and their outputs:
;
;   (recognises m o seqBITS)    output o reports the sequence BITS
;   (keeps_while o b)           o's sequence goes on while b keeps arriving
;   (reset_as_previous m b)     after reset it is as though the last input was b
;
; A sequence is an object named for its bits, seq0111110. The problem compiler
; (problem_compiler.py) expands the sequences into the states they need, one
; for every distinct prefix (named M3 for three bits matched, or S_FLAG where
; flag's sequence completes), and says how the prefixes extend one another:
;
;   (sequence_start m s)        the state for "nothing of any sequence yet"
;   (child s b t)               t's prefix is s's followed by b
;   (no_child s b)              no sequence continues from s with b
;   (holds_on s b)              s is the end of a sequence that goes on while b
;
; That is bookkeeping on the description's own bits. The design is not in it:
; where a state goes when its sequences break off is derived here, by the
; Aho-Corasick construction, which is the single pattern's derivation above
; carried to several patterns:
;
;   fallback(t)   = start                       for a child t of start
;                 = next(fallback(s), b)        for t = child(s, b), s /= start
;   next(s, b)    = s                           if s holds on b
;                 = child(s, b)                 if there is one
;                 = start                       if there is none and s = start
;                 = next(fallback(s), b)        if there is none, otherwise
;
; fallback(s) is the state for the longest proper suffix of s's prefix that
; is itself a prefix of some sequence, so each call is on a shorter prefix.

(define (domain rtl_fsm)
  (:requirements :typing :hierarchy :negative-preconditions
                 :disjunctive-preconditions :existential-preconditions
                 :method-preconditions)

  (:types
    module port register fsm_state bitval polarity width value bitseq - object
  )

  (:constants
    zero one - bitval
    active_high active_low - polarity
  )

  (:predicates
    ; ---- given by the problem: the interface ----
    (first_port ?m - module ?p - port)
    (next_port ?p ?q - port)
    (last_port ?m - module ?p - port)
    (input_port ?p - port)
    (output_port ?p - port)
    (port_width ?p - port ?w - width)
    (clock_of ?m - module ?p - port)
    (reset_of ?m - module ?p - port)
    (data_input_of ?m - module ?p - port)
    (detect_output_of ?m - module ?p - port)
    (reset_async ?p - port)
    (reset_polarity ?p - port ?pol - polarity)
    (cleared_by_reset ?out ?rst - port)

    ; ---- given by the problem: what kind of design ----
    (sequence_detector ?m - module)
    (table_fsm ?m - module)
    (sequence_recogniser ?m - module)
    (wrap_counter ?m - module)
    (triangle_generator ?m - module)
    (mealy ?m - module)
    (moore ?m - module)

    ; ---- given: sequence detectors ----
    (overlapping ?m - module)
    (initial_state ?m - module ?s - fsm_state)
    (last_state ?m - module ?s - fsm_state)
    (accept_state ?m - module ?s - fsm_state)
    (next_prefix ?s ?t - fsm_state)
    (expects ?s - fsm_state ?b - bitval)

    ; ---- given: listed-state FSMs (table FSMs, run classifiers) ----
    (first_listed ?m - module ?s - fsm_state)
    (listed_after ?s ?t - fsm_state)
    (last_listed ?m - module ?s - fsm_state)
    (table_next ?s - fsm_state ?b - bitval ?t - fsm_state)
    (asserted_in ?o - port ?s - fsm_state)

    ; ---- given: the state encoding of an FSM. Arithmetic, so not the
    ; planner's to derive: state k in declaration order has code k, and the
    ; width is the smallest that holds the highest code. Whatever writes the
    ; problem file computes both (rtl_designs/state_encoding.py) ----
    (state_code ?s - fsm_state ?c - value)
    (state_width ?m - module ?w - width)

    ; ---- given: sequence recognisers, as the description states them ----
    (recognises ?m - module ?o - port ?q - bitseq)
    (keeps_while ?o - port ?b - bitval)
    (reset_as_previous ?m - module ?b - bitval)
    ; ---- and as the problem compiler expands them ----
    (sequence_start ?m - module ?s - fsm_state)
    (child ?s - fsm_state ?b - bitval ?t - fsm_state)
    (no_child ?s - fsm_state ?b - bitval)
    (holds_on ?s - fsm_state ?b - bitval)

    ; ---- given: counters and generators ----
    (count_output ?m - module ?p - port)
    (enable_of ?m - module ?p - port)
    (count_min ?m - module ?v - value)
    (count_max ?m - module ?v - value)
    (wave_output ?m - module ?p - port)
    (direction_register ?m - module ?r - register)
    (register_width ?r - register ?w - width)
    (rising_code ?m - module ?v - value)
    (falling_code ?m - module ?v - value)

    ; ---- derived by analyze_* actions ----
    (fallback ?s ?f - fsm_state)
    (fallback_known ?s - fsm_state)
    (transition ?s - fsm_state ?b - bitval ?t - fsm_state)
    (transition_known ?s - fsm_state ?b - bitval)
    (asserts_output ?s - fsm_state ?b - bitval)
    (architecture_chosen ?m - module)
    (wraps_at ?m - module ?top ?bottom - value)
    (turns_at ?m - module ?phase ?limit ?next_phase - value)

    ; ---- progress of the code being written ----
    (port_declared ?p - port)
    (state_declared ?s - fsm_state)
    (state_case_written ?s - fsm_state)
    (section_written ?m - module)
  )

  ;; =====================================================================
  ;; Tasks
  ;; =====================================================================

  (:task implement_module :parameters (?m - module))

  ; phase 1: work out the design
  (:task design_state_machine :parameters (?m - module))
  (:task derive_transitions_from :parameters (?m - module ?s - fsm_state))
  (:task derive_next :parameters (?m - module ?s - fsm_state ?b - bitval))
  (:task derive_fallback :parameters (?m - module ?s - fsm_state))
  (:task derive_fallback_step :parameters (?m - module ?s ?p - fsm_state ?b - bitval))
  (:task derive_via_fallback :parameters (?m - module ?s - fsm_state ?b - bitval))
  (:task derive_match_restart :parameters (?m - module ?s - fsm_state ?b - bitval))
  ; These read off a transition the step before them has just derived. They
  ; are compound, not actions, so that the target ?t is bound only once that
  ; transition exists: a method parameter is grounded when the method is
  ; chosen, and binding ?t there would guess it before deriving it.
  (:task conclude_fall_back :parameters (?m - module ?s - fsm_state ?b - bitval ?f - fsm_state))
  (:task conclude_match_restart :parameters (?m - module ?s - fsm_state ?b - bitval ?f - fsm_state))
  (:task conclude_fallback_extend :parameters (?m - module ?s ?p - fsm_state ?b - bitval ?fp - fsm_state))
  (:task conclude_accept_restart :parameters (?m - module ?s - fsm_state ?b - bitval ?s0 - fsm_state))
  (:task read_state_table :parameters (?m - module))
  (:task read_table_from :parameters (?m - module ?s - fsm_state))
  (:task design_recogniser :parameters (?m - module))
  (:task recognise_from :parameters (?m - module ?s - fsm_state))
  (:task derive_sequence_next :parameters (?m - module ?s - fsm_state ?b - bitval))
  (:task derive_sequence_fallback :parameters (?m - module ?s - fsm_state))
  (:task derive_sequence_fallback_step :parameters (?m - module ?s ?p - fsm_state ?b - bitval))
  (:task derive_via_sequence_fallback :parameters (?m - module ?s - fsm_state ?b - bitval))
  (:task conclude_sequence_fallback :parameters (?m - module ?s ?p - fsm_state ?b - bitval ?fp - fsm_state))
  (:task design_generator :parameters (?m - module))

  ; phase 2: write the code
  (:task write_interface :parameters (?m - module))
  (:task declare_ports_from :parameters (?m - module ?p - port))
  (:task declare_port :parameters (?m - module ?p - port))
  (:task write_state_declarations :parameters (?m - module))
  (:task declare_states_from :parameters (?m - module ?s - fsm_state))
  (:task write_state_register :parameters (?m - module))
  (:task write_next_state_logic :parameters (?m - module))
  (:task write_state_cases_from :parameters (?m - module ?s - fsm_state))
  (:task write_output_logic :parameters (?m - module))
  (:task write_output_reset :parameters (?m - module ?out - port))
  (:task write_moore_outputs_from :parameters (?m - module ?p - port))
  (:task write_moore_output :parameters (?m - module ?p - port))
  (:task open_clocked_block :parameters (?m - module ?clk ?rst - port ?pol - polarity))
  (:task write_counter_logic :parameters (?m - module))
  (:task write_internal_registers :parameters (?m - module))
  (:task write_generator_logic :parameters (?m - module))

  ;; =====================================================================
  ;; Top level, one method per design family
  ;; =====================================================================

  (:method m_implement_mealy_sequence_detector
    :parameters (?m - module)
    :task (implement_module ?m)
    :precondition (and (sequence_detector ?m) (mealy ?m))
    :ordered-subtasks (and
      (t1 (analyze_choose_three_block_fsm ?m))
      (t2 (design_state_machine ?m))
      (t3 (write_interface ?m))
      (t4 (write_state_declarations ?m))
      (t5 (write_state_register ?m))
      (t6 (write_next_state_logic ?m))
      (t7 (write_output_logic ?m))
      (t8 (write_module_end ?m))
    )
  )

  (:method m_implement_moore_sequence_detector
    :parameters (?m - module ?out - port ?sa - fsm_state)
    :task (implement_module ?m)
    :precondition (and (sequence_detector ?m) (moore ?m)
                       (detect_output_of ?m ?out) (accept_state ?m ?sa))
    :ordered-subtasks (and
      (t1 (analyze_choose_moore_fsm ?m))
      (t2 (design_state_machine ?m))
      (t3 (analyze_output_in_accept_state ?m ?out ?sa))
      (t4 (write_interface ?m))
      (t5 (write_state_declarations ?m))
      (t6 (write_state_register ?m))
      (t7 (write_next_state_logic ?m))
      (t8 (write_output_logic ?m))
      (t9 (write_module_end ?m))
    )
  )

  (:method m_implement_table_fsm
    :parameters (?m - module)
    :task (implement_module ?m)
    :precondition (and (table_fsm ?m) (moore ?m))
    :ordered-subtasks (and
      (t1 (analyze_choose_moore_fsm ?m))
      (t2 (read_state_table ?m))
      (t3 (write_interface ?m))
      (t4 (write_state_declarations ?m))
      (t5 (write_state_register ?m))
      (t6 (write_next_state_logic ?m))
      (t7 (write_output_logic ?m))
      (t8 (write_module_end ?m))
    )
  )

  (:method m_implement_sequence_recogniser
    :parameters (?m - module)
    :task (implement_module ?m)
    :precondition (and (sequence_recogniser ?m) (moore ?m))
    :ordered-subtasks (and
      (t1 (analyze_choose_moore_fsm ?m))
      (t2 (design_recogniser ?m))
      (t3 (write_interface ?m))
      (t4 (write_state_declarations ?m))
      (t5 (write_state_register ?m))
      (t6 (write_next_state_logic ?m))
      (t7 (write_output_logic ?m))
      (t8 (write_module_end ?m))
    )
  )

  (:method m_implement_wrap_counter
    :parameters (?m - module ?top ?bottom - value)
    :task (implement_module ?m)
    :precondition (and (wrap_counter ?m) (count_max ?m ?top) (count_min ?m ?bottom))
    :ordered-subtasks (and
      (t1 (analyze_choose_counter_register ?m))
      (t2 (analyze_wrap_point ?m ?top ?bottom))
      (t3 (write_interface ?m))
      (t4 (write_counter_logic ?m))
      (t5 (write_module_end ?m))
    )
  )

  (:method m_implement_triangle_generator
    :parameters (?m - module)
    :task (implement_module ?m)
    :precondition (triangle_generator ?m)
    :ordered-subtasks (and
      (t1 (analyze_choose_direction_register ?m))
      (t2 (design_generator ?m))
      (t3 (write_interface ?m))
      (t4 (write_internal_registers ?m))
      (t5 (write_generator_logic ?m))
      (t6 (write_module_end ?m))
    )
  )

  ; Decide on the structure: a state register, a combinational next-state
  ; block, and a combinational (Mealy) output block.
  (:action analyze_choose_three_block_fsm
    :parameters (?module - module)
    :precondition (and (sequence_detector ?module) (mealy ?module))
    :effect (architecture_chosen ?module)
  )

  ; Decide on the structure: a state register, a combinational next-state
  ; block, and outputs decoded from the current state alone (Moore).
  (:action analyze_choose_moore_fsm
    :parameters (?module - module)
    :precondition (moore ?module)
    :effect (architecture_chosen ?module)
  )

  ;; =====================================================================
  ;; Phase 1, families 1 and 2: derive a sequence detector's transitions
  ;; =====================================================================

  (:method m_design_sequence_fsm
    :parameters (?m - module ?s0 - fsm_state)
    :task (design_state_machine ?m)
    :precondition (and (sequence_detector ?m) (architecture_chosen ?m) (initial_state ?m ?s0))
    :ordered-subtasks (and
      (t1 (derive_transitions_from ?m ?s0))
    )
  )

  ; Walk the states in pattern order, fixing both transitions out of each.
  (:method m_derive_transitions_more
    :parameters (?m - module ?s ?t - fsm_state)
    :task (derive_transitions_from ?m ?s)
    :precondition (next_prefix ?s ?t)
    :ordered-subtasks (and
      (t1 (derive_next ?m ?s zero))
      (t2 (derive_next ?m ?s one))
      (t3 (derive_transitions_from ?m ?t))
    )
  )

  (:method m_derive_transitions_last
    :parameters (?m - module ?s - fsm_state)
    :task (derive_transitions_from ?m ?s)
    :precondition (last_state ?m ?s)
    :ordered-subtasks (and
      (t1 (derive_next ?m ?s zero))
      (t2 (derive_next ?m ?s one))
    )
  )

  ; ---- next(s, b) ----

  ; Already derived, while working out an earlier state's fallback.
  (:method m_next_known
    :parameters (?m - module ?s - fsm_state ?b - bitval)
    :task (derive_next ?m ?s ?b)
    :precondition (transition_known ?s ?b)
    :ordered-subtasks ()
  )

  ; b is the bit wanted next: one more bit of the pattern is matched.
  (:method m_next_advance
    :parameters (?m - module ?s - fsm_state ?b - bitval ?t - fsm_state)
    :task (derive_next ?m ?s ?b)
    :precondition (and (not (transition_known ?s ?b))
                       (expects ?s ?b) (next_prefix ?s ?t))
    :ordered-subtasks (and
      (t1 (analyze_advance ?m ?s ?b ?t))
    )
  )

  ; A mismatch before anything is matched: stay in the initial state.
  (:method m_next_mismatch_initial
    :parameters (?m - module ?s - fsm_state ?b - bitval)
    :task (derive_next ?m ?s ?b)
    :precondition (and (not (transition_known ?s ?b))
                       (not (expects ?s ?b)) (initial_state ?m ?s))
    :ordered-subtasks (and
      (t1 (analyze_stay_initial ?m ?s ?b))
    )
  )

  ; A mismatch after a partial match: the longest matched suffix that is
  ; still a prefix of the pattern decides where to go. A Moore accepting
  ; state is handled this way too, when detection is overlapping.
  (:method m_next_mismatch_fallback
    :parameters (?m - module ?s - fsm_state ?b - bitval)
    :task (derive_next ?m ?s ?b)
    :precondition (and (not (transition_known ?s ?b))
                       (not (expects ?s ?b)) (not (initial_state ?m ?s))
                       (or (overlapping ?m) (not (accept_state ?m ?s))))
    :ordered-subtasks (and
      (t1 (derive_fallback ?m ?s))
      (t2 (derive_via_fallback ?m ?s ?b))
    )
  )

  (:method m_via_fallback
    :parameters (?m - module ?s - fsm_state ?b - bitval ?f - fsm_state)
    :task (derive_via_fallback ?m ?s ?b)
    :precondition (fallback ?s ?f)
    :ordered-subtasks (and
      (t1 (derive_next ?m ?f ?b))
      (t2 (conclude_fall_back ?m ?s ?b ?f))
    )
  )

  (:method m_conclude_fall_back
    :parameters (?m - module ?s - fsm_state ?b - bitval ?f ?t - fsm_state)
    :task (conclude_fall_back ?m ?s ?b ?f)
    :precondition (transition ?f ?b ?t)
    :ordered-subtasks (and
      (t1 (analyze_fall_back ?m ?s ?b ?f ?t))
    )
  )

  ; Mealy: the last bit of the pattern arrives and the output fires. With
  ; overlapping detection, the matched bits may already begin the next
  ; occurrence.
  (:method m_next_match_overlapping
    :parameters (?m - module ?s - fsm_state ?b - bitval)
    :task (derive_next ?m ?s ?b)
    :precondition (and (not (transition_known ?s ?b))
                       (expects ?s ?b) (last_state ?m ?s)
                       (overlapping ?m) (not (initial_state ?m ?s)))
    :ordered-subtasks (and
      (t1 (derive_fallback ?m ?s))
      (t2 (derive_match_restart ?m ?s ?b))
    )
  )

  (:method m_match_restart
    :parameters (?m - module ?s - fsm_state ?b - bitval ?f - fsm_state)
    :task (derive_match_restart ?m ?s ?b)
    :precondition (fallback ?s ?f)
    :ordered-subtasks (and
      (t1 (derive_next ?m ?f ?b))
      (t2 (conclude_match_restart ?m ?s ?b ?f))
    )
  )

  (:method m_conclude_match_restart
    :parameters (?m - module ?s - fsm_state ?b - bitval ?f ?t - fsm_state)
    :task (conclude_match_restart ?m ?s ?b ?f)
    :precondition (transition ?f ?b ?t)
    :ordered-subtasks (and
      (t1 (analyze_match_overlapping ?m ?s ?b ?f ?t))
    )
  )

  ; Mealy, non-overlapping detection or a one-bit pattern: after a match,
  ; start again from the initial state.
  (:method m_next_match_from_scratch
    :parameters (?m - module ?s - fsm_state ?b - bitval ?s0 - fsm_state)
    :task (derive_next ?m ?s ?b)
    :precondition (and (not (transition_known ?s ?b))
                       (expects ?s ?b) (last_state ?m ?s)
                       (or (not (overlapping ?m)) (initial_state ?m ?s))
                       (initial_state ?m ?s0))
    :ordered-subtasks (and
      (t1 (analyze_match_from_scratch ?m ?s ?b ?s0))
    )
  )

  ; Moore, non-overlapping: the accepting state behaves like the initial one.
  (:method m_next_accept_from_scratch
    :parameters (?m - module ?s - fsm_state ?b - bitval ?s0 - fsm_state)
    :task (derive_next ?m ?s ?b)
    :precondition (and (not (transition_known ?s ?b)) (accept_state ?m ?s)
                       (not (overlapping ?m)) (initial_state ?m ?s0))
    :ordered-subtasks (and
      (t1 (derive_next ?m ?s0 ?b))
      (t2 (conclude_accept_restart ?m ?s ?b ?s0))
    )
  )

  (:method m_conclude_accept_restart
    :parameters (?m - module ?s - fsm_state ?b - bitval ?s0 ?t - fsm_state)
    :task (conclude_accept_restart ?m ?s ?b ?s0)
    :precondition (transition ?s0 ?b ?t)
    :ordered-subtasks (and
      (t1 (analyze_restart_from_accept ?m ?s ?b ?s0 ?t))
    )
  )

  ; ---- fallback(s): the state for the longest proper suffix of the bits
  ; matched in s that is also a prefix of the pattern ----

  (:method m_fallback_known
    :parameters (?m - module ?s - fsm_state)
    :task (derive_fallback ?m ?s)
    :precondition (fallback_known ?s)
    :ordered-subtasks ()
  )

  (:method m_fallback_first
    :parameters (?m - module ?s ?p - fsm_state)
    :task (derive_fallback ?m ?s)
    :precondition (and (not (fallback_known ?s))
                       (next_prefix ?p ?s) (initial_state ?m ?p))
    :ordered-subtasks (and
      (t1 (analyze_fallback_first ?m ?s ?p))
    )
  )

  (:method m_fallback_extend
    :parameters (?m - module ?s ?p - fsm_state ?b - bitval)
    :task (derive_fallback ?m ?s)
    :precondition (and (not (fallback_known ?s))
                       (next_prefix ?p ?s) (not (initial_state ?m ?p))
                       (expects ?p ?b))
    :ordered-subtasks (and
      (t1 (derive_fallback ?m ?p))
      (t2 (derive_fallback_step ?m ?s ?p ?b))
    )
  )

  (:method m_fallback_step
    :parameters (?m - module ?s ?p - fsm_state ?b - bitval ?fp - fsm_state)
    :task (derive_fallback_step ?m ?s ?p ?b)
    :precondition (fallback ?p ?fp)
    :ordered-subtasks (and
      (t1 (derive_next ?m ?fp ?b))
      (t2 (conclude_fallback_extend ?m ?s ?p ?b ?fp))
    )
  )

  (:method m_conclude_fallback_extend
    :parameters (?m - module ?s ?p - fsm_state ?b - bitval ?fp ?t - fsm_state)
    :task (conclude_fallback_extend ?m ?s ?p ?b ?fp)
    :precondition (transition ?fp ?b ?t)
    :ordered-subtasks (and
      (t1 (analyze_fallback_extend ?m ?s ?p ?b ?fp ?t))
    )
  )

  ; ---- phase 1 actions, families 1 and 2 ----

  ; In ?state, input ?bit is the next pattern bit: go to ?next_state.
  (:action analyze_advance
    :parameters (?module - module ?state - fsm_state ?bit - bitval ?next_state - fsm_state)
    :precondition (and (architecture_chosen ?module) (expects ?state ?bit)
                       (next_prefix ?state ?next_state))
    :effect (and (transition ?state ?bit ?next_state) (transition_known ?state ?bit))
  )

  ; In the initial state, an input ?bit that is not the first pattern bit:
  ; stay there.
  (:action analyze_stay_initial
    :parameters (?module - module ?state - fsm_state ?bit - bitval)
    :precondition (and (initial_state ?module ?state) (not (expects ?state ?bit)))
    :effect (and (transition ?state ?bit ?state) (transition_known ?state ?bit))
  )

  ; In ?state, input ?bit breaks the match: go where the fallback state goes
  ; on ?bit, which is ?next_state.
  (:action analyze_fall_back
    :parameters (?module - module ?state - fsm_state ?bit - bitval
                 ?fallback_state ?next_state - fsm_state)
    :precondition (and (architecture_chosen ?module) (fallback ?state ?fallback_state)
                       (transition ?fallback_state ?bit ?next_state))
    :effect (and (transition ?state ?bit ?next_state) (transition_known ?state ?bit))
  )

  ; Mealy: in the last state, input ?bit completes the pattern. Assert the
  ; output on this transition, and go where the fallback state goes on ?bit
  ; (overlapping detection).
  (:action analyze_match_overlapping
    :parameters (?module - module ?state - fsm_state ?bit - bitval
                 ?fallback_state ?next_state - fsm_state)
    :precondition (and (last_state ?module ?state) (expects ?state ?bit)
                       (fallback ?state ?fallback_state)
                       (transition ?fallback_state ?bit ?next_state))
    :effect (and (transition ?state ?bit ?next_state) (transition_known ?state ?bit)
                 (asserts_output ?state ?bit))
  )

  ; Mealy: in the last state, input ?bit completes the pattern. Assert the
  ; output on this transition, and go back to the initial state.
  (:action analyze_match_from_scratch
    :parameters (?module - module ?state - fsm_state ?bit - bitval ?initial_state - fsm_state)
    :precondition (and (last_state ?module ?state) (expects ?state ?bit)
                       (initial_state ?module ?initial_state))
    :effect (and (transition ?state ?bit ?initial_state) (transition_known ?state ?bit)
                 (asserts_output ?state ?bit))
  )

  ; Moore, non-overlapping: in the accepting state, input ?bit goes where the
  ; initial state goes on ?bit, which is ?next_state.
  (:action analyze_restart_from_accept
    :parameters (?module - module ?state - fsm_state ?bit - bitval
                 ?initial_state ?next_state - fsm_state)
    :precondition (and (accept_state ?module ?state) (initial_state ?module ?initial_state)
                       (transition ?initial_state ?bit ?next_state))
    :effect (and (transition ?state ?bit ?next_state) (transition_known ?state ?bit))
  )

  ; ?state has one bit matched; its fallback is the initial state.
  (:action analyze_fallback_first
    :parameters (?module - module ?state ?initial_state - fsm_state)
    :precondition (and (next_prefix ?initial_state ?state) (initial_state ?module ?initial_state))
    :effect (and (fallback ?state ?initial_state) (fallback_known ?state))
  )

  ; ?state is reached from ?previous_state on ?bit; its fallback is where the
  ; previous state's fallback goes on ?bit, which is ?fallback_state.
  (:action analyze_fallback_extend
    :parameters (?module - module ?state ?previous_state - fsm_state ?bit - bitval
                 ?previous_fallback ?fallback_state - fsm_state)
    :precondition (and (architecture_chosen ?module) (next_prefix ?previous_state ?state)
                       (expects ?previous_state ?bit)
                       (fallback ?previous_state ?previous_fallback)
                       (transition ?previous_fallback ?bit ?fallback_state))
    :effect (and (fallback ?state ?fallback_state) (fallback_known ?state))
  )

  ; Moore: the detector output is 1 exactly while the FSM is in the
  ; accepting state.
  (:action analyze_output_in_accept_state
    :parameters (?module - module ?output - port ?accept_state - fsm_state)
    :precondition (and (moore ?module) (detect_output_of ?module ?output)
                       (accept_state ?module ?accept_state))
    :effect (asserted_in ?output ?accept_state)
  )

  ;; =====================================================================
  ;; Phase 1, family 3: read a table FSM's transitions
  ;; =====================================================================

  (:method m_read_state_table
    :parameters (?m - module ?s - fsm_state)
    :task (read_state_table ?m)
    :precondition (and (table_fsm ?m) (first_listed ?m ?s))
    :ordered-subtasks (and (t1 (read_table_from ?m ?s)))
  )

  (:method m_read_table_more
    :parameters (?m - module ?s ?t ?t0 ?t1 - fsm_state)
    :task (read_table_from ?m ?s)
    :precondition (and (listed_after ?s ?t) (table_next ?s zero ?t0) (table_next ?s one ?t1))
    :ordered-subtasks (and
      (t1 (analyze_read_transition ?m ?s zero ?t0))
      (t2 (analyze_read_transition ?m ?s one ?t1))
      (t3 (read_table_from ?m ?t))
    )
  )

  (:method m_read_table_last
    :parameters (?m - module ?s ?t0 ?t1 - fsm_state)
    :task (read_table_from ?m ?s)
    :precondition (and (last_listed ?m ?s) (table_next ?s zero ?t0) (table_next ?s one ?t1))
    :ordered-subtasks (and
      (t1 (analyze_read_transition ?m ?s zero ?t0))
      (t2 (analyze_read_transition ?m ?s one ?t1))
    )
  )

  ; The table says: in ?state, on input ?bit, go to ?next_state.
  (:action analyze_read_transition
    :parameters (?module - module ?state - fsm_state ?bit - bitval ?next_state - fsm_state)
    :precondition (and (architecture_chosen ?module) (table_next ?state ?bit ?next_state)
                       (not (transition_known ?state ?bit)))
    :effect (and (transition ?state ?bit ?next_state) (transition_known ?state ?bit))
  )

  ;; =====================================================================
  ;; Phase 1, family 4: derive a sequence recogniser's transitions
  ;; =====================================================================

  (:method m_design_recogniser
    :parameters (?m - module ?s - fsm_state)
    :task (design_recogniser ?m)
    :precondition (and (sequence_recogniser ?m) (first_listed ?m ?s))
    :ordered-subtasks (and (t1 (recognise_from ?m ?s)))
  )

  ; Walk the states in the order they are listed, fixing both transitions
  ; out of each.
  (:method m_recognise_more
    :parameters (?m - module ?s ?t - fsm_state)
    :task (recognise_from ?m ?s)
    :precondition (listed_after ?s ?t)
    :ordered-subtasks (and
      (t1 (derive_sequence_next ?m ?s zero))
      (t2 (derive_sequence_next ?m ?s one))
      (t3 (recognise_from ?m ?t))
    )
  )

  (:method m_recognise_last
    :parameters (?m - module ?s - fsm_state)
    :task (recognise_from ?m ?s)
    :precondition (last_listed ?m ?s)
    :ordered-subtasks (and
      (t1 (derive_sequence_next ?m ?s zero))
      (t2 (derive_sequence_next ?m ?s one))
    )
  )

  ; ---- next(s, b) ----

  ; Already derived, while working out another state's fallback.
  (:method m_sequence_next_known
    :parameters (?m - module ?s - fsm_state ?b - bitval)
    :task (derive_sequence_next ?m ?s ?b)
    :precondition (transition_known ?s ?b)
    :ordered-subtasks ()
  )

  ; The end of a sequence that goes on while b keeps arriving: stay.
  (:method m_sequence_next_hold
    :parameters (?m - module ?s - fsm_state ?b - bitval)
    :task (derive_sequence_next ?m ?s ?b)
    :precondition (and (not (transition_known ?s ?b)) (holds_on ?s ?b))
    :ordered-subtasks (and (t1 (analyze_keep_while ?m ?s ?b)))
  )

  ; b is the next bit of some sequence: one more bit is matched.
  (:method m_sequence_next_extend
    :parameters (?m - module ?s - fsm_state ?b - bitval ?t - fsm_state)
    :task (derive_sequence_next ?m ?s ?b)
    :precondition (and (not (transition_known ?s ?b)) (not (holds_on ?s ?b)) (child ?s ?b ?t))
    :ordered-subtasks (and (t1 (analyze_extend_sequence ?m ?s ?b ?t)))
  )

  ; No sequence starts with b: stay at the start.
  (:method m_sequence_next_stay
    :parameters (?m - module ?s - fsm_state ?b - bitval)
    :task (derive_sequence_next ?m ?s ?b)
    :precondition (and (not (transition_known ?s ?b)) (sequence_start ?m ?s) (no_child ?s ?b))
    :ordered-subtasks (and (t1 (analyze_stay_at_start ?m ?s ?b)))
  )

  ; No sequence continues with b: the longest matched suffix that still
  ; begins a sequence decides where to go.
  (:method m_sequence_next_fallback
    :parameters (?m - module ?s - fsm_state ?b - bitval)
    :task (derive_sequence_next ?m ?s ?b)
    :precondition (and (not (transition_known ?s ?b)) (not (holds_on ?s ?b))
                       (no_child ?s ?b) (not (sequence_start ?m ?s)))
    :ordered-subtasks (and
      (t1 (derive_sequence_fallback ?m ?s))
      (t2 (derive_via_sequence_fallback ?m ?s ?b))
    )
  )

  (:method m_via_sequence_fallback
    :parameters (?m - module ?s - fsm_state ?b - bitval ?f - fsm_state)
    :task (derive_via_sequence_fallback ?m ?s ?b)
    :precondition (fallback ?s ?f)
    :ordered-subtasks (and
      (t1 (derive_sequence_next ?m ?f ?b))
      (t2 (conclude_fall_back ?m ?s ?b ?f))
    )
  )

  ; ---- fallback(s) ----

  (:method m_sequence_fallback_known
    :parameters (?m - module ?s - fsm_state)
    :task (derive_sequence_fallback ?m ?s)
    :precondition (fallback_known ?s)
    :ordered-subtasks ()
  )

  (:method m_sequence_fallback_first
    :parameters (?m - module ?s ?r - fsm_state ?b - bitval)
    :task (derive_sequence_fallback ?m ?s)
    :precondition (and (not (fallback_known ?s)) (child ?r ?b ?s) (sequence_start ?m ?r))
    :ordered-subtasks (and (t1 (analyze_sequence_fallback_first ?m ?s ?r)))
  )

  (:method m_sequence_fallback_extend
    :parameters (?m - module ?s ?p - fsm_state ?b - bitval)
    :task (derive_sequence_fallback ?m ?s)
    :precondition (and (not (fallback_known ?s)) (child ?p ?b ?s) (not (sequence_start ?m ?p)))
    :ordered-subtasks (and
      (t1 (derive_sequence_fallback ?m ?p))
      (t2 (derive_sequence_fallback_step ?m ?s ?p ?b))
    )
  )

  (:method m_sequence_fallback_step
    :parameters (?m - module ?s ?p - fsm_state ?b - bitval ?fp - fsm_state)
    :task (derive_sequence_fallback_step ?m ?s ?p ?b)
    :precondition (fallback ?p ?fp)
    :ordered-subtasks (and
      (t1 (derive_sequence_next ?m ?fp ?b))
      (t2 (conclude_sequence_fallback ?m ?s ?p ?b ?fp))
    )
  )

  (:method m_conclude_sequence_fallback
    :parameters (?m - module ?s ?p - fsm_state ?b - bitval ?fp ?t - fsm_state)
    :task (conclude_sequence_fallback ?m ?s ?p ?b ?fp)
    :precondition (transition ?fp ?b ?t)
    :ordered-subtasks (and (t1 (analyze_sequence_fallback_extend ?m ?s ?p ?b ?fp ?t)))
  )

  ; ---- phase 1 actions, family 4 ----

  ; In ?state, input ?bit is the next bit of a sequence: go to ?next_state.
  (:action analyze_extend_sequence
    :parameters (?module - module ?state - fsm_state ?bit - bitval ?next_state - fsm_state)
    :precondition (and (architecture_chosen ?module) (child ?state ?bit ?next_state))
    :effect (and (transition ?state ?bit ?next_state) (transition_known ?state ?bit))
  )

  ; In the start state, no sequence begins with ?bit: stay there.
  (:action analyze_stay_at_start
    :parameters (?module - module ?state - fsm_state ?bit - bitval)
    :precondition (and (sequence_start ?module ?state) (no_child ?state ?bit))
    :effect (and (transition ?state ?bit ?state) (transition_known ?state ?bit))
  )

  ; ?state ends a sequence that goes on while ?bit keeps arriving: stay in it.
  (:action analyze_keep_while
    :parameters (?module - module ?state - fsm_state ?bit - bitval)
    :precondition (and (architecture_chosen ?module) (holds_on ?state ?bit))
    :effect (and (transition ?state ?bit ?state) (transition_known ?state ?bit))
  )

  ; ?state has matched one bit; its fallback is the start state.
  (:action analyze_sequence_fallback_first
    :parameters (?module - module ?state ?start_state - fsm_state)
    :precondition (sequence_start ?module ?start_state)
    :effect (and (fallback ?state ?start_state) (fallback_known ?state))
  )

  ; ?state is reached from ?previous_state on ?bit; its fallback is where the
  ; previous state's fallback goes on ?bit, which is ?fallback_state.
  (:action analyze_sequence_fallback_extend
    :parameters (?module - module ?state ?previous_state - fsm_state ?bit - bitval
                 ?previous_fallback ?fallback_state - fsm_state)
    :precondition (and (architecture_chosen ?module) (child ?previous_state ?bit ?state)
                       (fallback ?previous_state ?previous_fallback)
                       (transition ?previous_fallback ?bit ?fallback_state))
    :effect (and (fallback ?state ?fallback_state) (fallback_known ?state))
  )

  ;; =====================================================================
  ;; Phase 1, families 5 and 6: counters and generators
  ;; =====================================================================

  ; Decide on the structure: one clocked block that updates the count
  ; register held in the output.
  (:action analyze_choose_counter_register
    :parameters (?module - module)
    :precondition (wrap_counter ?module)
    :effect (architecture_chosen ?module)
  )

  ; After counting up to ?top, the count wraps around to ?bottom.
  (:action analyze_wrap_point
    :parameters (?module - module ?top ?bottom - value)
    :precondition (and (count_max ?module ?top) (count_min ?module ?bottom))
    :effect (wraps_at ?module ?top ?bottom)
  )

  ; Decide on the structure: one clocked block that steps the wave register
  ; up or down, steered by a direction register.
  (:action analyze_choose_direction_register
    :parameters (?module - module)
    :precondition (triangle_generator ?module)
    :effect (architecture_chosen ?module)
  )

  (:method m_design_generator
    :parameters (?m - module ?rise ?fall ?low ?high - value)
    :task (design_generator ?m)
    :precondition (and (rising_code ?m ?rise) (falling_code ?m ?fall)
                       (count_min ?m ?low) (count_max ?m ?high))
    :ordered-subtasks (and
      (t1 (analyze_turn_point ?m ?rise ?high ?fall))
      (t2 (analyze_turn_point ?m ?fall ?low ?rise))
    )
  )

  ; In direction ?phase, when the wave reaches ?limit, switch the direction
  ; to ?next_phase and hold the wave at ?limit for that cycle.
  (:action analyze_turn_point
    :parameters (?module - module ?phase ?limit ?next_phase - value)
    :precondition (architecture_chosen ?module)
    :effect (turns_at ?module ?phase ?limit ?next_phase)
  )

  ;; =====================================================================
  ;; Phase 2: write the code
  ;; =====================================================================

  ; ---- module header and port declarations ----

  (:method m_write_interface
    :parameters (?m - module ?p - port)
    :task (write_interface ?m)
    :precondition (first_port ?m ?p)
    :ordered-subtasks (and
      (t1 (write_module_header ?m))
      (t2 (declare_ports_from ?m ?p))
    )
  )

  (:method m_declare_ports_more
    :parameters (?m - module ?p ?q - port)
    :task (declare_ports_from ?m ?p)
    :precondition (next_port ?p ?q)
    :ordered-subtasks (and
      (t1 (declare_port ?m ?p))
      (t2 (declare_ports_from ?m ?q))
    )
  )

  (:method m_declare_ports_last
    :parameters (?m - module ?p - port)
    :task (declare_ports_from ?m ?p)
    :precondition (last_port ?m ?p)
    :ordered-subtasks (and
      (t1 (declare_port ?m ?p))
    )
  )

  (:method m_declare_input
    :parameters (?m - module ?p - port)
    :task (declare_port ?m ?p)
    :precondition (input_port ?p)
    :ordered-subtasks (and (t1 (write_input_decl ?m ?p)))
  )

  ; A Mealy detector output is assigned inside an always block, so it is a reg.
  (:method m_declare_output_reg
    :parameters (?m - module ?p - port)
    :task (declare_port ?m ?p)
    :precondition (and (output_port ?p) (detect_output_of ?m ?p) (mealy ?m))
    :ordered-subtasks (and (t1 (write_output_reg_decl ?m ?p)))
  )

  ; A Moore output is a continuous assignment from the state, so it is a wire.
  (:method m_declare_output_wire
    :parameters (?m - module ?p - port)
    :task (declare_port ?m ?p)
    :precondition (and (output_port ?p) (moore ?m))
    :ordered-subtasks (and (t1 (write_output_decl ?m ?p)))
  )

  ; A counter's or generator's output is the register the clocked block
  ; updates, so it is a reg of the port's width.
  (:method m_declare_output_vector_reg
    :parameters (?m - module ?p - port ?w - width)
    :task (declare_port ?m ?p)
    :precondition (and (output_port ?p) (port_width ?p ?w)
                       (or (count_output ?m ?p) (wave_output ?m ?p)))
    :ordered-subtasks (and (t1 (write_output_reg_vector_decl ?m ?p ?w)))
  )

  ; `module <module>(<ports in declaration order>);`
  (:action write_module_header
    :parameters (?module - module)
    :precondition (architecture_chosen ?module)
    :effect (section_written ?module)
  )

  ; `input <port>;`
  (:action write_input_decl
    :parameters (?module - module ?port - port)
    :precondition (and (section_written ?module) (input_port ?port) (not (port_declared ?port)))
    :effect (port_declared ?port)
  )

  ; `output reg <port>;`
  (:action write_output_reg_decl
    :parameters (?module - module ?port - port)
    :precondition (and (section_written ?module) (detect_output_of ?module ?port)
                       (output_port ?port) (not (port_declared ?port)))
    :effect (port_declared ?port)
  )

  ; `output <port>;`
  (:action write_output_decl
    :parameters (?module - module ?port - port)
    :precondition (and (section_written ?module) (output_port ?port) (not (port_declared ?port)))
    :effect (port_declared ?port)
  )

  ; `output reg [<width>-1:0] <port>;`
  (:action write_output_reg_vector_decl
    :parameters (?module - module ?port - port ?width - width)
    :precondition (and (section_written ?module) (output_port ?port) (port_width ?port ?width)
                       (not (port_declared ?port)))
    :effect (port_declared ?port)
  )

  ; ---- state encoding and state registers ----

  (:method m_write_state_declarations
    :parameters (?m - module ?s0 - fsm_state ?w - width)
    :task (write_state_declarations ?m)
    :precondition (and (sequence_detector ?m) (initial_state ?m ?s0) (state_width ?m ?w))
    :ordered-subtasks (and
      (t1 (analyze_choose_state_encoding ?m ?s0 ?w))
      (t2 (declare_states_from ?m ?s0))
      (t3 (write_state_regs ?m ?w))
    )
  )

  (:method m_write_state_declarations_listed
    :parameters (?m - module ?s - fsm_state ?w - width)
    :task (write_state_declarations ?m)
    :precondition (and (first_listed ?m ?s) (state_width ?m ?w))
    :ordered-subtasks (and
      (t1 (analyze_choose_state_encoding ?m ?s ?w))
      (t2 (declare_states_from ?m ?s))
      (t3 (write_state_regs ?m ?w))
    )
  )

  (:method m_declare_states_more
    :parameters (?m - module ?s ?t - fsm_state ?c - value ?w - width)
    :task (declare_states_from ?m ?s)
    :precondition (and (next_prefix ?s ?t) (state_code ?s ?c) (state_width ?m ?w))
    :ordered-subtasks (and
      (t1 (write_state_param ?m ?s ?c ?w))
      (t2 (declare_states_from ?m ?t))
    )
  )

  (:method m_declare_states_last
    :parameters (?m - module ?s - fsm_state ?c - value ?w - width)
    :task (declare_states_from ?m ?s)
    :precondition (and (last_state ?m ?s) (state_code ?s ?c) (state_width ?m ?w))
    :ordered-subtasks (and
      (t1 (write_state_param ?m ?s ?c ?w))
    )
  )

  (:method m_declare_states_listed_more
    :parameters (?m - module ?s ?t - fsm_state ?c - value ?w - width)
    :task (declare_states_from ?m ?s)
    :precondition (and (listed_after ?s ?t) (state_code ?s ?c) (state_width ?m ?w))
    :ordered-subtasks (and
      (t1 (write_state_param ?m ?s ?c ?w))
      (t2 (declare_states_from ?m ?t))
    )
  )

  (:method m_declare_states_listed_last
    :parameters (?m - module ?s - fsm_state ?c - value ?w - width)
    :task (declare_states_from ?m ?s)
    :precondition (and (last_listed ?m ?s) (state_code ?s ?c) (state_width ?m ?w))
    :ordered-subtasks (and
      (t1 (write_state_param ?m ?s ?c ?w))
    )
  )

  ; Encode the states in binary, numbered in declaration order starting from
  ; ?first_state, in ?width bits: enough to number them all.
  (:action analyze_choose_state_encoding
    :parameters (?module - module ?first_state - fsm_state ?width - width)
    :precondition (and (architecture_chosen ?module) (state_width ?module ?width))
    :effect ()
  )

  ; `parameter <state> = <width>'d<code>;`
  (:action write_state_param
    :parameters (?module - module ?state - fsm_state ?code - value ?width - width)
    :precondition (and (architecture_chosen ?module) (not (state_declared ?state))
                       (state_code ?state ?code) (state_width ?module ?width)
                       (transition_known ?state zero) (transition_known ?state one))
    :effect (state_declared ?state)
  )

  ; `reg [<width>-1:0] ST_cr, ST_nt;` -- current and next state.
  (:action write_state_regs
    :parameters (?module - module ?width - width)
    :precondition (and (architecture_chosen ?module) (state_width ?module ?width))
    :effect ()
  )

  ; ---- block 1: the state register ----

  (:method m_state_register_async
    :parameters (?m - module ?clk ?rst - port ?pol - polarity ?s0 - fsm_state)
    :task (write_state_register ?m)
    :precondition (and (clock_of ?m ?clk) (reset_of ?m ?rst) (reset_async ?rst)
                       (reset_polarity ?rst ?pol) (initial_state ?m ?s0))
    :ordered-subtasks (and
      (t1 (write_state_register_async ?m ?clk ?rst ?pol ?s0))
    )
  )

  (:method m_state_register_sync
    :parameters (?m - module ?clk ?rst - port ?pol - polarity ?s0 - fsm_state)
    :task (write_state_register ?m)
    :precondition (and (clock_of ?m ?clk) (reset_of ?m ?rst) (not (reset_async ?rst))
                       (reset_polarity ?rst ?pol) (initial_state ?m ?s0))
    :ordered-subtasks (and
      (t1 (write_state_register_sync ?m ?clk ?rst ?pol ?s0))
    )
  )

  ; `always @(posedge <clock> or <posedge|negedge> <reset>)`:
  ; reset active -> ST_cr <= <reset_state>; otherwise ST_cr <= ST_nt.
  (:action write_state_register_async
    :parameters (?module - module ?clock ?reset - port ?polarity - polarity
                 ?reset_state - fsm_state)
    :precondition (and (clock_of ?module ?clock) (reset_of ?module ?reset)
                       (initial_state ?module ?reset_state)
                       (reset_async ?reset) (reset_polarity ?reset ?polarity))
    :effect ()
  )

  ; `always @(posedge <clock>)`:
  ; reset active -> ST_cr <= <reset_state>; otherwise ST_cr <= ST_nt.
  (:action write_state_register_sync
    :parameters (?module - module ?clock ?reset - port ?polarity - polarity
                 ?reset_state - fsm_state)
    :precondition (and (clock_of ?module ?clock) (reset_of ?module ?reset)
                       (initial_state ?module ?reset_state)
                       (not (reset_async ?reset)) (reset_polarity ?reset ?polarity))
    :effect ()
  )

  ; ---- block 2: next-state logic ----

  (:method m_write_next_state_logic
    :parameters (?m - module ?s0 - fsm_state)
    :task (write_next_state_logic ?m)
    :precondition (and (sequence_detector ?m) (initial_state ?m ?s0))
    :ordered-subtasks (and
      (t1 (write_next_state_open ?m))
      (t2 (write_state_cases_from ?m ?s0))
      (t3 (write_next_state_default ?m ?s0))
      (t4 (write_next_state_close ?m))
    )
  )

  (:method m_write_next_state_logic_listed
    :parameters (?m - module ?s ?s0 - fsm_state)
    :task (write_next_state_logic ?m)
    :precondition (and (first_listed ?m ?s) (initial_state ?m ?s0))
    :ordered-subtasks (and
      (t1 (write_next_state_open ?m))
      (t2 (write_state_cases_from ?m ?s))
      (t3 (write_next_state_default ?m ?s0))
      (t4 (write_next_state_close ?m))
    )
  )

  (:method m_state_cases_more
    :parameters (?m - module ?s ?t - fsm_state ?in - port ?t0 ?t1 - fsm_state)
    :task (write_state_cases_from ?m ?s)
    :precondition (and (next_prefix ?s ?t) (data_input_of ?m ?in)
                       (transition ?s zero ?t0) (transition ?s one ?t1))
    :ordered-subtasks (and
      (t1 (write_state_case ?m ?s ?in ?t0 ?t1))
      (t2 (write_state_cases_from ?m ?t))
    )
  )

  (:method m_state_cases_last
    :parameters (?m - module ?s - fsm_state ?in - port ?t0 ?t1 - fsm_state)
    :task (write_state_cases_from ?m ?s)
    :precondition (and (last_state ?m ?s) (data_input_of ?m ?in)
                       (transition ?s zero ?t0) (transition ?s one ?t1))
    :ordered-subtasks (and
      (t1 (write_state_case ?m ?s ?in ?t0 ?t1))
    )
  )

  (:method m_state_cases_listed_more
    :parameters (?m - module ?s ?t - fsm_state ?in - port ?t0 ?t1 - fsm_state)
    :task (write_state_cases_from ?m ?s)
    :precondition (and (listed_after ?s ?t) (data_input_of ?m ?in)
                       (transition ?s zero ?t0) (transition ?s one ?t1))
    :ordered-subtasks (and
      (t1 (write_state_case ?m ?s ?in ?t0 ?t1))
      (t2 (write_state_cases_from ?m ?t))
    )
  )

  (:method m_state_cases_listed_last
    :parameters (?m - module ?s - fsm_state ?in - port ?t0 ?t1 - fsm_state)
    :task (write_state_cases_from ?m ?s)
    :precondition (and (last_listed ?m ?s) (data_input_of ?m ?in)
                       (transition ?s zero ?t0) (transition ?s one ?t1))
    :ordered-subtasks (and
      (t1 (write_state_case ?m ?s ?in ?t0 ?t1))
    )
  )

  ; `always @(*) begin case (ST_cr)`
  (:action write_next_state_open
    :parameters (?module - module)
    :precondition (architecture_chosen ?module)
    :effect ()
  )

  ; `<state>: if (<input> == 0) ST_nt = <next_if_0>; else ST_nt = <next_if_1>;`
  (:action write_state_case
    :parameters (?module - module ?state - fsm_state ?input - port
                 ?next_if_0 ?next_if_1 - fsm_state)
    :precondition (and (data_input_of ?module ?input) (state_declared ?state)
                       (not (state_case_written ?state))
                       (transition ?state zero ?next_if_0) (transition ?state one ?next_if_1))
    :effect (state_case_written ?state)
  )

  ; `default: ST_nt = <reset_state>;` -- unused encodings recover to the
  ; reset state.
  (:action write_next_state_default
    :parameters (?module - module ?reset_state - fsm_state)
    :precondition (initial_state ?module ?reset_state)
    :effect ()
  )

  ; `endcase end`
  (:action write_next_state_close
    :parameters (?module - module)
    :precondition (architecture_chosen ?module)
    :effect ()
  )

  ; ---- block 3, Mealy: output logic from state and input ----

  (:method m_write_mealy_output
    :parameters (?m - module ?out ?in - port ?s - fsm_state ?b - bitval)
    :task (write_output_logic ?m)
    :precondition (and (mealy ?m) (detect_output_of ?m ?out)
                       (data_input_of ?m ?in) (asserts_output ?s ?b))
    :ordered-subtasks (and
      (t1 (write_output_open ?m ?out))
      (t2 (write_output_reset ?m ?out))
      (t3 (write_output_assert ?m ?out ?s ?in ?b))
      (t4 (write_output_default ?m ?out))
      (t5 (write_output_close ?m))
    )
  )

  (:method m_output_reset_clause
    :parameters (?m - module ?out ?rst - port ?pol - polarity)
    :task (write_output_reset ?m ?out)
    :precondition (and (reset_of ?m ?rst) (cleared_by_reset ?out ?rst)
                       (reset_polarity ?rst ?pol))
    :ordered-subtasks (and
      (t1 (write_output_reset_clause ?m ?out ?rst ?pol))
    )
  )

  (:method m_output_no_reset_clause
    :parameters (?m - module ?out ?rst - port)
    :task (write_output_reset ?m ?out)
    :precondition (and (reset_of ?m ?rst) (not (cleared_by_reset ?out ?rst)))
    :ordered-subtasks ()
  )

  ; `always @(*) begin`
  (:action write_output_open
    :parameters (?module - module ?output - port)
    :precondition (detect_output_of ?module ?output)
    :effect ()
  )

  ; `if (<reset> is active) <output> = 0;`
  (:action write_output_reset_clause
    :parameters (?module - module ?output ?reset - port ?polarity - polarity)
    :precondition (and (reset_of ?module ?reset) (cleared_by_reset ?output ?reset)
                       (reset_polarity ?reset ?polarity))
    :effect ()
  )

  ; `[else] if (ST_cr == <state> && <input> == <bit>) <output> = 1;`
  (:action write_output_assert
    :parameters (?module - module ?output - port ?state - fsm_state ?input - port
                 ?bit - bitval)
    :precondition (and (detect_output_of ?module ?output) (data_input_of ?module ?input)
                       (asserts_output ?state ?bit) (state_declared ?state))
    :effect ()
  )

  ; `else <output> = 0;`
  (:action write_output_default
    :parameters (?module - module ?output - port)
    :precondition (detect_output_of ?module ?output)
    :effect ()
  )

  ; `end`
  (:action write_output_close
    :parameters (?module - module)
    :precondition (architecture_chosen ?module)
    :effect ()
  )

  ; ---- block 3, Moore: each output decoded from the state ----

  (:method m_write_moore_outputs
    :parameters (?m - module ?p - port)
    :task (write_output_logic ?m)
    :precondition (and (moore ?m) (first_port ?m ?p))
    :ordered-subtasks (and (t1 (write_moore_outputs_from ?m ?p)))
  )

  (:method m_moore_outputs_more
    :parameters (?m - module ?p ?q - port)
    :task (write_moore_outputs_from ?m ?p)
    :precondition (next_port ?p ?q)
    :ordered-subtasks (and
      (t1 (write_moore_output ?m ?p))
      (t2 (write_moore_outputs_from ?m ?q))
    )
  )

  (:method m_moore_outputs_last
    :parameters (?m - module ?p - port)
    :task (write_moore_outputs_from ?m ?p)
    :precondition (last_port ?m ?p)
    :ordered-subtasks (and (t1 (write_moore_output ?m ?p)))
  )

  (:method m_moore_output_assign
    :parameters (?m - module ?p - port ?s - fsm_state)
    :task (write_moore_output ?m ?p)
    :precondition (and (output_port ?p) (asserted_in ?p ?s))
    :ordered-subtasks (and (t1 (write_moore_output_assign ?m ?p ?s)))
  )

  (:method m_moore_output_skip_input
    :parameters (?m - module ?p - port)
    :task (write_moore_output ?m ?p)
    :precondition (input_port ?p)
    :ordered-subtasks ()
  )

  ; `assign <output> = (ST_cr == <state>);`
  (:action write_moore_output_assign
    :parameters (?module - module ?output - port ?state - fsm_state)
    :precondition (and (moore ?module) (asserted_in ?output ?state) (state_declared ?state))
    :effect ()
  )

  ; ---- clocked blocks for counters and generators ----

  (:method m_open_clocked_block_async
    :parameters (?m - module ?clk ?rst - port ?pol - polarity)
    :task (open_clocked_block ?m ?clk ?rst ?pol)
    :precondition (reset_async ?rst)
    :ordered-subtasks (and (t1 (write_clocked_block_open_async ?m ?clk ?rst ?pol)))
  )

  (:method m_open_clocked_block_sync
    :parameters (?m - module ?clk ?rst - port ?pol - polarity)
    :task (open_clocked_block ?m ?clk ?rst ?pol)
    :precondition (not (reset_async ?rst))
    :ordered-subtasks (and (t1 (write_clocked_block_open_sync ?m ?clk ?rst ?pol)))
  )

  ; `always @(posedge <clock> or <posedge|negedge> <reset>) begin`
  (:action write_clocked_block_open_async
    :parameters (?module - module ?clock ?reset - port ?polarity - polarity)
    :precondition (and (clock_of ?module ?clock) (reset_of ?module ?reset)
                       (reset_async ?reset) (reset_polarity ?reset ?polarity))
    :effect ()
  )

  ; `always @(posedge <clock>) begin`
  (:action write_clocked_block_open_sync
    :parameters (?module - module ?clock ?reset - port ?polarity - polarity)
    :precondition (and (clock_of ?module ?clock) (reset_of ?module ?reset)
                       (not (reset_async ?reset)) (reset_polarity ?reset ?polarity))
    :effect ()
  )

  ; `end` -- closes the clocked block.
  (:action write_clocked_block_close
    :parameters (?module - module)
    :precondition (architecture_chosen ?module)
    :effect ()
  )

  ; ---- family 5: wrap-around counter ----

  (:method m_write_counter_logic
    :parameters (?m - module ?clk ?rst - port ?pol - polarity ?out ?en - port
                 ?top ?bottom - value)
    :task (write_counter_logic ?m)
    :precondition (and (clock_of ?m ?clk) (reset_of ?m ?rst) (reset_polarity ?rst ?pol)
                       (count_output ?m ?out) (enable_of ?m ?en)
                       (wraps_at ?m ?top ?bottom))
    :ordered-subtasks (and
      (t1 (open_clocked_block ?m ?clk ?rst ?pol))
      (t2 (write_counter_reset ?m ?out ?rst ?pol ?bottom))
      (t3 (write_counter_enable_open ?m ?en))
      (t4 (write_counter_wrap ?m ?out ?top ?bottom))
      (t5 (write_counter_enable_close ?m))
      (t6 (write_counter_hold ?m ?out))
      (t7 (write_clocked_block_close ?m))
    )
  )

  ; `if (<reset> is active) <counter> <= <reset_value>;`
  (:action write_counter_reset
    :parameters (?module - module ?counter ?reset - port ?polarity - polarity
                 ?reset_value - value)
    :precondition (and (count_output ?module ?counter) (reset_of ?module ?reset)
                       (reset_polarity ?reset ?polarity) (count_min ?module ?reset_value))
    :effect ()
  )

  ; `else if (<enable>) begin`
  (:action write_counter_enable_open
    :parameters (?module - module ?enable - port)
    :precondition (enable_of ?module ?enable)
    :effect ()
  )

  ; `if (<counter> == <top>) <counter> <= <wrap_to>; else <counter> <= <counter> + 1;`
  (:action write_counter_wrap
    :parameters (?module - module ?counter - port ?top ?wrap_to - value)
    :precondition (and (count_output ?module ?counter) (wraps_at ?module ?top ?wrap_to))
    :effect ()
  )

  ; `end`
  (:action write_counter_enable_close
    :parameters (?module - module)
    :precondition (architecture_chosen ?module)
    :effect ()
  )

  ; `else <counter> <= <counter>;` -- hold the count while not enabled.
  (:action write_counter_hold
    :parameters (?module - module ?counter - port)
    :precondition (count_output ?module ?counter)
    :effect ()
  )

  ; ---- family 6: triangle-wave generator ----

  (:method m_write_internal_registers
    :parameters (?m - module ?r - register ?w - width)
    :task (write_internal_registers ?m)
    :precondition (and (direction_register ?m ?r) (register_width ?r ?w))
    :ordered-subtasks (and (t1 (write_register_decl ?m ?r ?w)))
  )

  ; `reg [<width>-1:0] <register>;`
  (:action write_register_decl
    :parameters (?module - module ?register - register ?width - width)
    :precondition (and (section_written ?module) (register_width ?register ?width))
    :effect ()
  )

  (:method m_write_generator_logic
    :parameters (?m - module ?clk ?rst - port ?pol - polarity ?dir - register ?wave - port
                 ?rise ?fall ?low ?high - value)
    :task (write_generator_logic ?m)
    :precondition (and (clock_of ?m ?clk) (reset_of ?m ?rst) (reset_polarity ?rst ?pol)
                       (direction_register ?m ?dir) (wave_output ?m ?wave)
                       (rising_code ?m ?rise) (falling_code ?m ?fall)
                       (turns_at ?m ?rise ?high ?fall) (turns_at ?m ?fall ?low ?rise))
    :ordered-subtasks (and
      (t1 (open_clocked_block ?m ?clk ?rst ?pol))
      (t2 (write_generator_reset ?m ?rst ?pol ?dir ?rise ?wave ?low))
      (t3 (write_direction_case_open ?m ?dir))
      (t4 (write_rising_phase ?m ?dir ?rise ?wave ?high ?fall))
      (t5 (write_falling_phase ?m ?dir ?fall ?wave ?low ?rise))
      (t6 (write_direction_case_close ?m))
      (t7 (write_clocked_block_close ?m))
    )
  )

  ; `if (<reset> is active) begin <direction> <= <direction_value>;
  ;  <wave> <= <wave_value>; end else begin`
  (:action write_generator_reset
    :parameters (?module - module ?reset - port ?polarity - polarity ?direction - register
                 ?direction_value - value ?wave - port ?wave_value - value)
    :precondition (and (reset_of ?module ?reset) (reset_polarity ?reset ?polarity)
                       (direction_register ?module ?direction) (wave_output ?module ?wave))
    :effect ()
  )

  ; `case (<direction>)`
  (:action write_direction_case_open
    :parameters (?module - module ?direction - register)
    :precondition (direction_register ?module ?direction)
    :effect ()
  )

  ; `<phase>: if (<wave> == <limit>) <direction> <= <next_phase>;
  ;  else <wave> <= <wave> + 1;`
  (:action write_rising_phase
    :parameters (?module - module ?direction - register ?phase - value ?wave - port
                 ?limit ?next_phase - value)
    :precondition (and (wave_output ?module ?wave) (turns_at ?module ?phase ?limit ?next_phase))
    :effect ()
  )

  ; `<phase>: if (<wave> == <limit>) <direction> <= <next_phase>;
  ;  else <wave> <= <wave> - 1;`
  (:action write_falling_phase
    :parameters (?module - module ?direction - register ?phase - value ?wave - port
                 ?limit ?next_phase - value)
    :precondition (and (wave_output ?module ?wave) (turns_at ?module ?phase ?limit ?next_phase))
    :effect ()
  )

  ; `endcase end` -- closes the case and the reset's else branch.
  (:action write_direction_case_close
    :parameters (?module - module)
    :precondition (architecture_chosen ?module)
    :effect ()
  )

  ; `endmodule`
  (:action write_module_end
    :parameters (?module - module)
    :precondition (and (architecture_chosen ?module) (section_written ?module))
    :effect ()
  )
)
